# Claude feedback/welfare logs (per user's global CLAUDE.md: not tracked)
logs/

# CppPkg build output directories (consumer-side build trees; ./build per CPP_PKG.md)
build/

# Rust build output (once the crate exists)
target/

# Generated provider scripts are machine-specific (absolute binary path baked in)
cppkg_provider.cmake

# Disposable upstream clones inside migrations (pin.sh recreates them)
migrations/*/upstream/
migrations/*/ref-build/
